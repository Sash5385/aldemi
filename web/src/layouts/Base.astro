---
import '../styles/global.css';
import { ui, localePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  path?: string;
}

const { lang, title, description, path = '/' } = Astro.props;
const tr = ui[lang];
const pageTitle = title ? `${title} — AlDemi` : tr['meta.title'];
const desc = description ?? tr['meta.desc'];
const other: Lang = lang === 'uk' ? 'en' : 'uk';
const site = Astro.site!;
const ukUrl = new URL(localePath('uk', path), site).href;
const enUrl = new URL(localePath('en', path), site).href;
const canonical = lang === 'uk' ? ukUrl : enUrl;
const home = localePath(lang);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="uk" href={ukUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={ukUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'uk' ? 'uk_UA' : 'en_US'} />
    <meta name="theme-color" content="#1e2433" />
    <link rel="preload" href="/fonts/onest-cyrillic-800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add("js")</script>
  </head>
  <body class="neo min-h-screen antialiased">
    <div class="bg" aria-hidden="true"><i class="orb o1"></i><i class="orb o2"></i><i class="orb o3"></i></div>
    <div id="fxbar" aria-hidden="true"></div>
    <header class="sticky top-0 z-20 bg-[#1e2433]/90 backdrop-blur-md">
      <nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
        <a href={`${home}#contact`} class="n-out-s n-press grid h-11 w-11 place-items-center rounded-full text-[var(--nm)]" aria-label={tr['nav.contact']}>✉</a>
        <a href={home} class="text-lg font-extrabold tracking-tight">Al<span class="text-[var(--accent)]">Demi</span></a>
        <a href={localePath(other, path)} hreflang={other} class="n-out-s n-press grid h-11 w-11 place-items-center rounded-full text-xs font-extrabold text-[var(--nm)]">
          {other === 'uk' ? 'UA' : 'EN'}
        </a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="py-8 text-center text-sm text-[var(--nm)]">
      © {year} AlDemi
    </footer>
    <script>
      const root = document.documentElement;
      let tick = false;
      const upd = () => {
        const sy = window.scrollY || 0, max = Math.max(1, root.scrollHeight - innerHeight);
        root.style.setProperty('--p', Math.min(1, sy / max).toFixed(4));
        root.style.setProperty('--syn', sy.toFixed(0));
      };
      addEventListener('scroll', () => { if (!tick) { tick = true; requestAnimationFrame(() => { upd(); tick = false; }); } }, { passive: true });
      addEventListener('resize', upd); upd();
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }), { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      document.querySelectorAll<HTMLElement>('.spot').forEach((el) => el.addEventListener('pointermove', (ev) => {
        const r = el.getBoundingClientRect();
        el.style.setProperty('--x', `${ev.clientX - r.left}px`);
        el.style.setProperty('--y', `${ev.clientY - r.top}px`);
      }));
    </script>
  </body>
</html>
