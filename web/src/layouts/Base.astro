---
import '../styles/global.css';
import { ui, localePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  path?: string;
}

const { lang, title, description, path = '/' } = Astro.props;
const tr = ui[lang];
const pageTitle = title ? `${title} — AlDemi` : tr['meta.title'];
const desc = description ?? tr['meta.desc'];
const other: Lang = lang === 'uk' ? 'en' : 'uk';
const site = Astro.site!;
const ukUrl = new URL(localePath('uk', path), site).href;
const enUrl = new URL(localePath('en', path), site).href;
const canonical = lang === 'uk' ? ukUrl : enUrl;
const home = localePath(lang);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="uk" href={ukUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={ukUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'uk' ? 'uk_UA' : 'en_US'} />
    <meta name="theme-color" content="#1e2433" />
    <link rel="preload" href="/fonts/onest-cyrillic-800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add("js");
      (function () {
        try {
          var q = new URLSearchParams(location.search).get("fx");
          if (q === "0") sessionStorage.removeItem("fx");
          else if (q) sessionStorage.setItem("fx", q);
          var f = sessionStorage.getItem("fx");
          if (f) document.documentElement.setAttribute("data-fx", f);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="neo min-h-screen antialiased">
    <div class="bg" aria-hidden="true"><i class="orb o1"></i><i class="orb o2"></i><i class="orb o3"></i></div>
    <div id="fxbar" aria-hidden="true"></div>
    <header class="sticky top-0 z-20 bg-[#1e2433]/90 backdrop-blur-md">
      <nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
        <a href={`${home}#contact`} class="n-out-s n-press grid h-11 w-11 place-items-center rounded-full text-[var(--nm)]" aria-label={tr['nav.contact']}>✉</a>
        <a href={home} class="text-lg font-extrabold tracking-tight">Al<span class="text-[var(--accent)]">Demi</span></a>
        <a href={localePath(other, path)} hreflang={other} class="n-out-s n-press grid h-11 w-11 place-items-center rounded-full text-xs font-extrabold text-[var(--nm)]">
          {other === 'uk' ? 'UA' : 'EN'}
        </a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="py-8 text-center text-sm text-[var(--nm)]">
      © {year} AlDemi
    </footer>
    <script>
      const root = document.documentElement;
      let tick = false;
      const upd = () => {
        const sy = window.scrollY || 0, max = Math.max(1, root.scrollHeight - innerHeight);
        root.style.setProperty('--p', Math.min(1, sy / max).toFixed(4));
        root.style.setProperty('--syn', sy.toFixed(0));
      };
      addEventListener('scroll', () => { if (!tick) { tick = true; requestAnimationFrame(() => { upd(); tick = false; }); } }, { passive: true });
      addEventListener('resize', upd); upd();
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }), { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      const fx = Number(root.dataset.fx || 0);
      if (fx) {
        const names = ['', 'Підйом', 'Повільна поява', 'Зліва', 'Зліва / справа', 'Наближення', 'Віддалення', '3D-фліп вгору', '3D-поворот картки', 'Підйом з нахилом', 'Видавлювання (неоморф)', 'З розмиття', 'Шторка знизу', 'Коло', 'Пружина', 'Падіння зверху', 'Розгойдування', 'Скіс', 'Прив’язка до скролу', 'Паралакс секцій', '3D-нахил + стиснення hero', '3D-падіння згори', 'З глибини', 'Поп', 'Розгортання вбік', 'Розгортання вниз', 'Переворот 180°', 'Глітч', 'Шторка зліва', 'Діагональ', 'Спалах', 'Пружина справа', 'З ч/б у колір', 'З кута', 'Сплющення', 'Сходинки', 'Вдавлене → випукле', 'Виїзд при скролі', '3D-карусель', 'Фокус у центрі', 'Стопка карток'];
        const go = (n: number) => `${location.pathname}?fx=${((n + 39) % 40) + 1}`;
        const bar = document.createElement('div');
        bar.id = 'fxbar-switch';
        bar.innerHTML = `<a href="${go(fx - 1)}">‹</a><span><b>${fx}</b>/40 · ${names[fx] ?? ''}</span><a href="${go(fx + 1)}">›</a><a href="${location.pathname}?fx=0" title="off">✕</a>`;
        document.body.appendChild(bar);
      }
      document.querySelectorAll<HTMLElement>('.spot').forEach((el) => el.addEventListener('pointermove', (ev) => {
        const r = el.getBoundingClientRect();
        el.style.setProperty('--x', `${ev.clientX - r.left}px`);
        el.style.setProperty('--y', `${ev.clientY - r.top}px`);
      }));
    </script>
  </body>
</html>
