---
interface Props { slug: string; color: string; class?: string }
const { slug, color, class: cls = '' } = Astro.props;
---
<svg viewBox="0 0 200 120" class={`art ${cls}`} style={`color:${color}`} aria-hidden="true">
  {slug === 'finddrive' && (
    <g>
      <g stroke="currentColor" stroke-opacity=".15">
        <path d="M0 30h200M0 60h200M0 90h200M40 0v120M90 0v120M140 0v120" />
        <path d="M10 110 L70 50 L120 75 L190 15" stroke-opacity=".45" stroke-width="3" fill="none" stroke-dasharray="6 6" />
      </g>
      <circle cx="120" cy="75" r="10" fill="currentColor" fill-opacity=".35" class="pulse" />
      <circle cx="120" cy="75" r="10" fill="currentColor" fill-opacity=".35" class="pulse d2" />
      <g class="bob">
        <path d="M120 72c-9-10-14-17-14-24a14 14 0 0 1 28 0c0 7-5 14-14 24z" fill="currentColor" />
        <circle cx="120" cy="48" r="5" fill="#07090d" />
      </g>
      <circle cx="70" cy="50" r="4" fill="currentColor" fill-opacity=".7" />
      <circle cx="40" cy="90" r="4" fill="currentColor" fill-opacity=".5" />
      <circle cx="170" cy="30" r="4" fill="currentColor" fill-opacity=".5" />
    </g>
  )}
  {slug === 'drivepad' && (
    <g>
      <rect x="36" y="12" width="128" height="96" rx="12" fill="currentColor" fill-opacity=".08" stroke="currentColor" stroke-opacity=".35" />
      <rect x="36" y="12" width="128" height="22" rx="12" fill="currentColor" fill-opacity=".35" />
      {[0, 1, 2, 3, 4].map((c) => [0, 1, 2].map((r) => (
        <rect x={46 + c * 23} y={42 + r * 21} width="17" height="15" rx="4" fill="currentColor"
          fill-opacity={(c + r) % 3 === 0 ? '.85' : '.18'} class={c === 3 && r === 1 ? 'blink' : ''} />
      )))}
      <g class="bob"><circle cx="164" cy="104" r="14" fill="currentColor" /><path d="M157 104l5 5 9-10" stroke="#07090d" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round" /></g>
    </g>
  )}
  {slug === 'juno' && (
    <g>
      {[0, 1, 2, 3].map((i) => (
        <g>
          <text x="22" y={30 + i * 24} font-size="10" fill="currentColor" fill-opacity=".55" font-family="monospace">{`${10 + i}:00`}</text>
          <rect x="60" y={20 + i * 24} width="120" height="14" rx="7" fill="currentColor" fill-opacity=".1" />
        </g>
      ))}
      <rect x="60" y="20" width="70" height="14" rx="7" fill="currentColor" fill-opacity=".9" class="slide" />
      <rect x="90" y="68" width="60" height="14" rx="7" fill="currentColor" fill-opacity=".55" />
      <rect x="60" y="92" width="44" height="14" rx="7" fill="currentColor" fill-opacity=".75" class="blink" />
    </g>
  )}
  {slug === 'magentic' && (
    <g>
      <rect x="44" y="10" width="112" height="100" rx="12" fill="currentColor" fill-opacity=".08" stroke="currentColor" stroke-opacity=".35" />
      <path d="M60 36h80" stroke="currentColor" stroke-width="5" stroke-linecap="round" class="type" />
      <path d="M60 56h64" stroke="currentColor" stroke-opacity=".6" stroke-width="5" stroke-linecap="round" class="type t2" />
      <path d="M60 76h72" stroke="currentColor" stroke-opacity=".4" stroke-width="5" stroke-linecap="round" class="type t3" />
      <path d="M158 14l4 10 10 4-10 4-4 10-4-10-10-4 10-4z" fill="currentColor" class="twinkle" />
      <path d="M36 84l3 7 7 3-7 3-3 7-3-7-7-3 7-3z" fill="currentColor" fill-opacity=".7" class="twinkle" style="animation-delay:.8s" />
    </g>
  )}
</svg>
