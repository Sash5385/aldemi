---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectArt from './ProjectArt.astro';
import { accentOf } from '../lib/accents';
import { ui, localePath, type Lang } from '../i18n/ui';
import type { ProjectItem } from '../lib/projects';

interface Props { lang: Lang; project: ProjectItem }
const { lang, project } = Astro.props;
const { entry, slug } = project;
const tr = ui[lang];
const { Content } = await render(entry);
const c = accentOf(slug);
---
<Base lang={lang} title={entry.data.title} description={entry.data.tagline} path={`/projects/${slug}`}>
  <article class="mx-auto max-w-3xl px-4 py-12 text-center">
    <a href={`${localePath(lang)}#projects`} class="n-out-s n-press mx-auto mb-8 flex w-full max-w-xs items-center justify-center rounded-full py-3 text-sm font-bold">{tr['project.back']}</a>
    <h1 class="text-4xl font-extrabold sm:text-5xl">{entry.data.title}</h1>
    <span class="n-in mt-4 inline-block rounded-full px-4 py-1 text-xs font-bold" style={`color:${c}`}>{tr[`status.${entry.data.status}`]}</span>
    <p class="mx-auto mt-4 max-w-xl text-lg text-[var(--nm)]">{entry.data.tagline}</p>
    <div class="n-in mt-8 overflow-hidden rounded-[24px]">
      <ProjectArt slug={slug} color={c} class="mx-auto h-56 w-full max-w-md p-6" />
    </div>

    <div class="mt-6">
      <span class="n-lbl">{tr['project.stack']}</span>
      <div class="mt-3 flex flex-wrap justify-center gap-2">
        {entry.data.stack.map((s) => <span class="n-out-s rounded-lg px-2.5 py-1 text-xs text-[var(--nm)]">{s}</span>)}
      </div>
    </div>

    <div class="mx-auto mt-10 max-w-xl space-y-4 leading-relaxed text-[var(--nt)] [&_h2]:mt-8 [&_h2]:text-2xl [&_h2]:font-extrabold [&_li]:list-none [&_ul]:space-y-1">
      <Content />
    </div>

    <div class={`mx-auto mt-12 grid max-w-xl gap-4 ${entry.data.demo && entry.data.url ? 'sm:grid-cols-2' : ''}`}>
      {entry.data.demo && (
        <a href={entry.data.demo} target="_blank" rel="noopener" class="n-press btn-lg text-[#06121a]" style={`background:${c};box-shadow:0 8px 20px ${c}55`}>{tr['project.demo']}</a>
      )}
      {entry.data.url && (
        <a href={entry.data.url} target="_blank" rel="noopener" class="n-out-s n-press btn-lg">{tr['project.visit']} ↗</a>
      )}
      <a href={`${localePath(lang)}#contact`} class={`n-grad n-press btn-lg ${entry.data.demo && entry.data.url ? 'sm:col-span-2' : ''}`}>{tr['project.order']}</a>
    </div>
  </article>
</Base>
