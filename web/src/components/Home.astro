---
import Base from '../layouts/Base.astro';
import ProjectArt from './ProjectArt.astro';
import { ui, services, demoPresets, localePath, type Lang } from '../i18n/ui';
import { getProjects } from '../lib/projects';
import { accentOf } from '../lib/accents';
import { CONTACTS } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = ui[lang];
const projects = await getProjects(lang);

const planes = [
  { plane: 'rotateX(72deg)', inv: 'rotateX(-72deg)', inset: '2%', k: '.02', d: '24s' },
  { plane: 'rotateX(72deg) rotateY(32deg)', inv: 'rotateY(-32deg) rotateX(-72deg)', inset: '12%', k: '.12', d: '18s' },
  { plane: 'rotateX(72deg) rotateY(-32deg)', inv: 'rotateY(32deg) rotateX(-72deg)', inset: '12%', k: '.12', d: '30s' },
];
const sats = [
  { label: 'FD', c: accentOf('finddrive'), a: '0deg', ring: 0 },
  { label: 'JU', c: accentOf('juno'), a: '180deg', ring: 0 },
  { label: 'DP', c: accentOf('drivepad'), a: '90deg', ring: 1 },
  { label: 'MG', c: accentOf('magentic'), a: '270deg', ring: 2 },
];
const stack = ['React', 'TypeScript', 'Astro', 'Vite', 'Tailwind', 'Firebase', 'Realtime DB', 'FCM', 'Kotlin', 'Jetpack Compose', 'Node.js', 'GitHub Actions'];
const serviceIcons = [
  '<path d="M3 5h18v14H3z M3 9h18 M7 7h.01 M10 7h.01" />',
  '<path d="M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z M11 18h2" />',
  '<path d="M12 2l3 7h7l-5.5 4.5L18 21l-6-4-6 4 1.5-7.5L2 9h7z" />',
];
---
<Base lang={lang}>
  <!-- HERO -->
  <section class="mx-auto grid max-w-6xl items-center gap-12 px-4 pb-16 pt-14 sm:pt-24 lg:grid-cols-[1.1fr_.9fr]">
    <div>
      <span class="eyebrow reveal">{tr['hero.eyebrow']}</span>
      <h1 class="reveal mt-3 text-[clamp(34px,6vw,56px)] font-extrabold leading-[1.05] tracking-[-1.2px]" style="--delay:90ms">
        {tr['hero.t1']}<em>{tr['hero.em']}</em>{tr['hero.t2']}
      </h1>
      <p class="lead reveal mt-5 max-w-xl text-[19px] text-[#c9cbd1]" style="--delay:180ms">{tr['hero.sub']}</p>
      <div class="reveal mt-7 flex flex-wrap gap-3" style="--delay:270ms">
        <a href="#contact" class="btn-primary rounded-[14px] px-6 py-3.5 font-extrabold transition hover:-translate-y-px hover:brightness-110">{tr['hero.cta']}</a>
        <a href="#projects" class="rounded-[14px] border border-white/10 bg-white/5 px-6 py-3.5 font-extrabold transition hover:-translate-y-px hover:brightness-110">{tr['hero.cta2']}</a>
      </div>
      <p class="reveal mt-4 text-[13px] text-[#bdbfc6]" style="--delay:360ms">{tr['hero.note']}</p>
      <div class="reveal mt-5 flex flex-wrap gap-2" style="--delay:450ms">
        <span class="chip">🟢 {tr['hero.badge']}</span>
        <span class="chip">Web · Android</span>
        <span class="chip">Firebase</span>
      </div>
    </div>

    <div>
      <div class="orbit">
        <div class="scene">
          {planes.map((p, i) => (
            <div class="ring" style={`--plane:${p.plane};--inv:${p.inv};--inset:${p.inset};--k:${p.k};--d:${p.d}`}>
              {sats.filter((s) => s.ring === i).map((s) => (
                <span class="sat" style={`--a:${s.a};--c:${s.c}`}><i>{s.label}</i></span>
              ))}
            </div>
          ))}
          <div class="core"><span>A<span class="text-emerald-400">.</span></span></div>
        </div>
      </div>
    </div>
  </section>
  <div class="scrollcue -mt-6 mb-10 lg:hidden"><i></i><span>{tr['hero.scroll']}</span></div>

  <!-- STATS -->
  <section class="mx-auto max-w-6xl px-4">
    <div class="grid grid-cols-3 gap-3 rounded-2xl glass p-4 sm:p-6">
      {[['4', tr['stats.products']], ['2', tr['stats.platforms']], ['2', tr['stats.langs']]].map(([n, l], i) => (
        <div class="reveal text-center" style={`--delay:${i * 100}ms`}>
          <div class="text-3xl font-extrabold text-[var(--accent)] sm:text-4xl">{n}</div>
          <div class="mt-1 text-xs text-zinc-400 sm:text-sm">{l}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- PROJECTS -->
  <section id="projects" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20">
    <h2 class="sec-title reveal text-[clamp(26px,4.5vw,38px)] font-extrabold leading-tight tracking-[-.5px]">{tr['projects.title']}</h2>
    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {projects.map(({ entry, slug }, i) => {
        const c = accentOf(slug);
        return (
          <div class="spot reveal group relative glass overflow-hidden rounded-[18px] transition duration-300 hover:-translate-y-1 hover:border-white/30" style={`--c:${c};--delay:${(i % 2) * 120}ms`}>
            <div class="relative h-44 border-b border-white/5" style={`background:radial-gradient(120% 90% at 50% 0%, ${c}26, transparent 70%)`}>
              <ProjectArt slug={slug} color={c} class="absolute inset-0 m-auto h-full w-full p-4 transition duration-500 group-hover:scale-105" />
            </div>
            <div class="p-6">
              <div class="flex items-center justify-between gap-3">
                <h3 class="text-xl font-bold">{entry.data.title}</h3>
                <span class="rounded-full px-2.5 py-0.5 text-xs font-medium" style={`background:${c}22;color:${c}`}>{tr[`status.${entry.data.status}`]}</span>
              </div>
              <p class="mt-3 text-zinc-400">{entry.data.tagline}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {entry.data.stack.map((s) => <span class="rounded-md bg-white/5 px-2 py-0.5 text-xs text-zinc-400">{s}</span>)}
              </div>
              <div class="mt-5 flex flex-wrap items-center gap-3">
                <a href={localePath(lang, `/projects/${slug}`)} class="inline-flex items-center gap-1 text-sm font-semibold transition-all after:absolute after:inset-0 after:content-[''] hover:gap-2" style={`color:${c}`}>{tr['projects.more']}</a>
                {entry.data.demo && (
                  <a href={entry.data.demo} target="_blank" rel="noopener" class="relative z-10 ml-auto rounded-xl px-4 py-2 text-sm font-extrabold text-zinc-950 shadow-[0_0_24px_-4px_var(--c)] transition hover:-translate-y-0.5 hover:brightness-110" style={`background:${c}`}>{tr['project.demo']}</a>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- STACK MARQUEE -->
  <section class="py-6" aria-hidden="true">
    <div class="marquee">
      <div>
        {[...stack, ...stack].map((s) => (
          <span class="whitespace-nowrap chip">{s}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- JUNO DEMO -->
  <section id="demo" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20">
    <div class="spot reveal relative overflow-hidden rounded-3xl border border-pink-400/25 p-8 sm:p-12" style={`--c:${accentOf('juno')};background:radial-gradient(90% 120% at 100% 0%, #f472b622, transparent 60%), rgba(255,255,255,.03)`}>
      <div class="grid items-center gap-8 md:grid-cols-[1.3fr_1fr]">
        <div>
          <h2 class="text-3xl font-extrabold tracking-tight">{tr['demo.title']}</h2>
          <p class="mt-3 max-w-xl text-zinc-400">{tr['demo.lead']}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            {demoPresets[lang].map((d) => (
              <a href={`/junoadmin/?demo=1&preset=${d.id}`} target="_blank" rel="noopener" class="rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 text-sm font-medium transition hover:-translate-y-0.5 hover:border-pink-400/60 hover:bg-pink-400/10">{d.label}</a>
            ))}
          </div>
        </div>
        <ProjectArt slug="juno" color={accentOf('juno')} class="mx-auto hidden w-full max-w-xs md:block" />
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20">
    <h2 class="sec-title reveal text-[clamp(26px,4.5vw,38px)] font-extrabold leading-tight tracking-[-.5px]">{tr['services.title']}</h2>
    <div class="mt-10 grid gap-5 sm:grid-cols-3">
      {services[lang].map((s, i) => (
        <div class="spot reveal glass rounded-[18px] p-6 transition hover:-translate-y-1 hover:border-white/30" style={`--delay:${i * 120}ms`}>
          <div class="grid h-12 w-12 place-items-center rounded-2xl bg-gradient-to-br from-emerald-400/25 to-indigo-400/25 text-emerald-300">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={serviceIcons[i]} />
          </div>
          <h3 class="mt-5 text-lg font-bold">{s.title}</h3>
          <p class="mt-2 text-sm text-zinc-400">{s.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="mx-auto max-w-6xl scroll-mt-20 px-4 pb-24 pt-8">
    <div class="reveal relative overflow-hidden rounded-[2rem] p-[1px]" style="background:linear-gradient(120deg,#34d399,#60a5fa,#f472b6,#a78bfa)">
      <div class="relative rounded-[calc(2rem-1px)] bg-[#0a0d13]/95 p-8 text-center sm:p-14">
        <h2 class="text-3xl font-extrabold tracking-tight sm:text-5xl">{tr['contact.title']}</h2>
        <p class="mt-4 text-zinc-400">{tr['contact.sub']}</p>
        <div class="mt-10 flex flex-wrap justify-center gap-3">
          <a href={CONTACTS.telegram} target="_blank" rel="noopener" class="btn-primary rounded-[14px] px-6 py-3.5 font-extrabold transition hover:-translate-y-px hover:brightness-110">Telegram</a>
          <a href={`mailto:${CONTACTS.email}`} class="rounded-xl border border-white/15 bg-white/5 px-6 py-3 font-semibold transition hover:-translate-y-0.5 hover:border-white/30">{CONTACTS.email}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
