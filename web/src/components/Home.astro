---
import Base from '../layouts/Base.astro';
import ProjectArt from './ProjectArt.astro';
import { ui, services, demoPresets, localePath, type Lang } from '../i18n/ui';
import { getProjects } from '../lib/projects';
import { accentOf } from '../lib/accents';
import { CONTACTS } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = ui[lang];
const projects = await getProjects(lang);
const ABBR: Record<string, string> = { finddrive: 'FD', drivepad: 'DP', juno: 'JU', magentic: 'MG' };

const planes = [
  { plane: 'rotateX(72deg)', inv: 'rotateX(-72deg)', inset: '2%', k: '.02', d: '24s' },
  { plane: 'rotateX(72deg) rotateY(32deg)', inv: 'rotateY(-32deg) rotateX(-72deg)', inset: '12%', k: '.12', d: '18s' },
  { plane: 'rotateX(72deg) rotateY(-32deg)', inv: 'rotateY(32deg) rotateX(-72deg)', inset: '12%', k: '.12', d: '30s' },
];
const sats = [
  { label: 'FD', c: accentOf('finddrive'), a: '0deg', ring: 0 },
  { label: 'JU', c: accentOf('juno'), a: '180deg', ring: 0 },
  { label: 'DP', c: accentOf('drivepad'), a: '90deg', ring: 1 },
  { label: 'MG', c: accentOf('magentic'), a: '270deg', ring: 2 },
];
const stack = ['React', 'TypeScript', 'Astro', 'Vite', 'Tailwind', 'Firebase', 'Realtime DB', 'FCM', 'Kotlin', 'Jetpack Compose', 'Node.js', 'GitHub Actions'];
const serviceIcons = [
  '<path d="M3 5h18v14H3z M3 9h18 M7 7h.01 M10 7h.01" />',
  '<path d="M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z M11 18h2" />',
  '<path d="M12 2l3 7h7l-5.5 4.5L18 21l-6-4-6 4 1.5-7.5L2 9h7z" />',
];
---
<Base lang={lang}>
  <!-- HERO -->
  <section class="mx-auto max-w-5xl px-4 pt-6">
    <div class="n-out reveal relative overflow-hidden rounded-[28px] p-6 sm:p-10">
      <div class="n-in pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full sm:h-80 sm:w-80" aria-hidden="true"></div>
      <span class="n-lbl relative">{tr['hero.eyebrow']}</span>
      <h1 class="relative mt-3 max-w-2xl text-[clamp(30px,6vw,52px)] font-extrabold leading-[1.08] tracking-[-1px]">
        {tr['hero.t1']}<em class="not-italic text-[var(--accent)]">{tr['hero.em']}</em>{tr['hero.t2']}
      </h1>
      <p class="relative mt-4 max-w-xl text-[var(--nm)]">{tr['hero.sub']}</p>
      <div class="relative mt-7 flex items-center gap-4">
        <a href="#contact" class="n-grad n-press grid h-16 w-16 place-items-center rounded-full text-2xl" aria-label={tr['hero.write']}>✉</a>
        <a href="#contact" class="font-extrabold">{tr['hero.write']}</a>
        <a href="#projects" class="n-out-s n-press ml-auto grid h-12 w-12 place-items-center rounded-full text-lg" aria-label={tr['hero.cta2']}>→</a>
      </div>
    </div>
  </section>

  <!-- APP TILES -->
  <section class="mx-auto max-w-5xl px-4 pt-8">
    <div class="grid grid-cols-4 gap-3 sm:gap-6">
      {projects.map(({ entry, slug }, i) => {
        const c = accentOf(slug);
        return (
          <a href={localePath(lang, `/projects/${slug}`)} class="reveal text-center" style={`--delay:${i * 80}ms`}>
            <span class="n-out-s n-tile mx-auto grid aspect-square w-full max-w-[84px] place-items-center rounded-[22px] text-sm font-extrabold" style={`color:${c}`}>{ABBR[slug] ?? entry.data.title.slice(0, 2).toUpperCase()}</span>
            <span class="mt-2 block truncate text-xs text-[var(--nm)]">{entry.data.title}</span>
          </a>
        );
      })}
    </div>
  </section>

  <!-- STATS -->
  <section class="mx-auto max-w-5xl px-4 pt-8">
    <div class="grid grid-cols-3 gap-3 sm:gap-6">
      {[['4', tr['stats.products']], ['2', tr['stats.platforms'].split(':')[0]], ['2', tr['stats.uptime']]].map(([n, l], i) => (
        <div class="n-in reveal rounded-[20px] py-4 text-center" style={`--delay:${i * 80}ms`}>
          <div class="text-2xl font-extrabold text-[var(--accent)]">{n}</div>
          <div class="mt-1 text-xs text-[var(--nm)]">{l}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- PROJECTS -->
  <section id="projects" class="mx-auto max-w-5xl scroll-mt-20 px-4 py-16">
    <h2 class="reveal text-[clamp(26px,4.5vw,36px)] font-extrabold tracking-[-.5px]">{tr['projects.title']}</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {projects.map(({ entry, slug }, i) => {
        const c = accentOf(slug);
        return (
          <div class="n-out reveal relative overflow-hidden rounded-[24px]" style={`--delay:${(i % 2) * 100}ms`}>
            <div class="n-in m-4 rounded-[18px]">
              <ProjectArt slug={slug} color={c} class="mx-auto h-40 w-full p-4" />
            </div>
            <div class="px-6 pb-6">
              <div class="flex items-center justify-between gap-3">
                <h3 class="text-xl font-extrabold">{entry.data.title}</h3>
                <span class="n-in rounded-full px-3 py-1 text-xs font-bold" style={`color:${c}`}>{tr[`status.${entry.data.status}`]}</span>
              </div>
              <p class="mt-2 text-[var(--nm)]">{entry.data.tagline}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {entry.data.stack.map((s) => <span class="n-out-s rounded-lg px-2.5 py-1 text-xs text-[var(--nm)]">{s}</span>)}
              </div>
              <div class="mt-6 flex items-center gap-3">
                <a href={localePath(lang, `/projects/${slug}`)} class="n-out-s n-press inline-flex min-h-[80px] items-center justify-center rounded-full px-7 text-sm font-extrabold">{tr['projects.more']}</a>
                {entry.data.demo && (
                  <a href={entry.data.demo} target="_blank" rel="noopener" class="n-press ml-auto inline-flex min-h-[80px] items-center justify-center rounded-full px-7 text-sm font-extrabold text-[#06121a]" style={`background:${c};box-shadow:0 8px 20px ${c}55`}>{tr['project.demo']}</a>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- JUNO DEMO -->
  <section id="demo" class="mx-auto max-w-5xl scroll-mt-20 px-4 pb-16">
    <div class="n-out reveal rounded-[28px] p-6 sm:p-10">
      <span class="n-lbl">Juno</span>
      <h2 class="mt-2 text-2xl font-extrabold sm:text-3xl">{tr['demo.title']}</h2>
      <p class="mt-2 max-w-xl text-[var(--nm)]">{tr['demo.lead']}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        {demoPresets[lang].map((d) => (
          <a href={`/junoadmin/?demo=1&preset=${d.id}`} target="_blank" rel="noopener" class="n-out-s n-press inline-flex min-h-[80px] items-center justify-center rounded-full px-6 text-sm font-bold">{d.label}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" class="mx-auto max-w-5xl scroll-mt-20 px-4 pb-16">
    <h2 class="reveal text-[clamp(26px,4.5vw,36px)] font-extrabold tracking-[-.5px]">{tr['services.title']}</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-3">
      {services[lang].map((s, i) => (
        <div class="n-out reveal rounded-[24px] p-6" style={`--delay:${i * 100}ms`}>
          <div class="n-in grid h-14 w-14 place-items-center rounded-[18px] text-[var(--accent)]">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={serviceIcons[i]} />
          </div>
          <h3 class="mt-5 text-lg font-extrabold">{s.title}</h3>
          <p class="mt-2 text-sm text-[var(--nm)]">{s.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="mx-auto max-w-5xl scroll-mt-20 px-4 pb-20">
    <div class="n-in reveal rounded-[28px] p-8 text-center sm:p-12">
      <h2 class="text-3xl font-extrabold sm:text-4xl">{tr['contact.title']}</h2>
      <p class="mt-3 text-[var(--nm)]">{tr['contact.sub']}</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href={CONTACTS.telegram} target="_blank" rel="noopener" class="n-grad n-press inline-flex min-h-[104px] items-center justify-center rounded-full px-9 font-extrabold">Telegram</a>
        <a href={`mailto:${CONTACTS.email}`} class="n-out-s n-press inline-flex min-h-[104px] items-center justify-center rounded-full px-9 font-extrabold">{CONTACTS.email}</a>
      </div>
    </div>
  </section>
</Base>
